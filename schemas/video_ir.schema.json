{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fps",
    "width",
    "height",
    "total_frames",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "fps": {
      "const": 30
    },
    "width": {
      "const": 1920
    },
    "height": {
      "const": 1080
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_frame",
          "end_frame",
          "engine"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "engine": {
            "enum": [
              "procedural",
              "image",
              "clip"
            ]
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "engine": {
              "enum": [
                "image",
                "clip"
              ]
            }
          }
        },
        "then": {
          "required": [
            "asset_id"
          ]
        }
      }
    }
  }
}
